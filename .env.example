# server
SERVER_PORT=3000

# postgres
POSTGRES_URL=postgres://database_user:database_password@localhost:5432/price_parser
POSTGRES_DB=price_parser
POSTGRES_USER=database_user
POSTGRES_PASSWORD=database_password

# redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# parser
PARSER_CRON_PATTERN="0 */4 * * *"
PARSER_BASE_DELAY_MS=3500
PARSER_SPREAD_DELAY_MS=1000
