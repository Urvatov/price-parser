{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "dprint configuration",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string"
		},
		"typescript": {
			"type": "object",
			"description": "TypeScript / JavaScript formatting properties",
			"properties": {
				"lineWidth": { "type": "number", "default": 120 },
				"indentWidth": { "type": "number", "default": 2 },
				"useTabs": { "type": "boolean", "default": false },
				"newLineKind": {
					"type": "string",
					"enum": ["auto", "crlf", "lf", "system"],
					"default": "lf"
				},
				"quoteStyle": {
					"type": "string",
					"enum": [
						"alwaysDouble",
						"alwaysSingle",
						"preferDouble",
						"preferSingle"
					]
				},
				"semiColons": { "type": "string", "enum": ["always", "prefer", "asi"] },
				"quoteProps": { "type": "string", "enum": ["asNeeded", "preserve"] },
				"useBraces": {
					"type": "string",
					"enum": ["always", "whenNotSingleLine", "maintain"]
				},
				"bracePosition": {
					"type": "string",
					"enum": ["maintain", "sameLine", "sameLineUnlessHanging", "nextLine"]
				},
				"singleBodyPosition": {
					"type": "string",
					"enum": ["maintain", "sameLine", "nextLine"]
				},
				"nextControlFlowPosition": {
					"type": "string",
					"enum": ["maintain", "sameLine", "nextLine"],
					"description": "Where to place catch, else, while after closing brace."
				},
				"trailingCommas": {
					"type": "string",
					"enum": ["never", "always", "onlyMultiLine"]
				},
				"operatorPosition": {
					"type": "string",
					"enum": ["maintain", "sameLine", "nextLine"]
				},
				"preferHanging": {
					"type": "string",
					"enum": ["always", "never", "onlySingleItem"]
				},
				"preferSingleLine": { "type": "boolean" },
				"spaceAround": { "type": "boolean" },
				"spaceSurroundingProperties": { "type": "boolean" },
				"ignoreNodeCommentText": { "type": "string" },
				"ignoreFileCommentText": { "type": "string" },
				"arguments.trailingCommas": {
					"type": "string",
					"enum": ["never", "always", "onlyMultiLine"]
				},
				"arguments.preferHanging": {
					"type": "string",
					"enum": ["always", "never", "onlySingleItem"]
				},
				"arrayExpression.trailingCommas": {
					"type": "string",
					"enum": ["never", "always", "onlyMultiLine"]
				},
				"arrowFunction.bracePosition": {
					"type": "string",
					"enum": ["maintain", "sameLine", "sameLineUnlessHanging", "nextLine"]
				},
				"arrowFunction.useParentheses": {
					"type": "string",
					"enum": ["force", "maintain", "preferNone"]
				},
				"binaryExpression.operatorPosition": {
					"type": "string",
					"enum": ["maintain", "sameLine", "nextLine"]
				},
				"ifStatement.nextControlFlowPosition": {
					"type": "string",
					"enum": ["maintain", "sameLine", "nextLine"]
				},
				"tryStatement.nextControlFlowPosition": {
					"type": "string",
					"enum": ["maintain", "sameLine", "nextLine"]
				},
				"doWhileStatement.nextControlFlowPosition": {
					"type": "string",
					"enum": ["maintain", "sameLine", "nextLine"]
				},
				"importDeclaration.sortNamedImports": {
					"type": "string",
					"enum": ["caseInsensitive", "caseSensitive", "maintain"]
				},
				"exportDeclaration.sortNamedExports": {
					"type": "string",
					"enum": ["caseInsensitive", "caseSensitive", "maintain"]
				},
				"module.sortImportDeclarations": {
					"type": "string",
					"enum": ["caseInsensitive", "caseSensitive", "maintain"]
				},
				"module.sortExportDeclarations": {
					"type": "string",
					"enum": ["caseInsensitive", "caseSensitive", "maintain"]
				}
			},
			"additionalProperties": true
		},
		"json": {
			"type": "object",
			"additionalProperties": true
		},
		"yaml": {
			"type": "object",
			"additionalProperties": true
		},
		"excludes": {
			"type": "array",
			"items": { "type": "string" }
		},
		"plugins": {
			"type": "array",
			"items": { "type": "string" }
		}
	},
	"additionalProperties": true
}
