{
	"name": "price-parser",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*"
	],
	"scripts": {
		"dev": "concurrently -n server,client -c blue,magenta \"npm run dev --workspace=price-parser-server\" \"npm run dev --workspace=price-parser-client\"",
		"dev:server": "npm run dev --workspace=price-parser-server",
		"dev:client": "npm run dev --workspace=price-parser-client",
		"build": "npm run build --workspaces",
		"build:server": "npm run build --workspace=price-parser-server",
		"build:client": "npm run build --workspace=price-parser-client",
		"start:server": "npm run start --workspace=price-parser-server",
		"preview:client": "npm run preview --workspace=price-parser-client",
		"typecheck": "npm run typecheck --workspace=price-parser-server && npm run check --workspace=price-parser-client",
		"format": "dprint fmt --no-gitignore",
		"db:push": "npm run db:push --workspace=price-parser-server",
		"db:generate": "npm run db:generate --workspace=price-parser-server",
		"db:drop": "npm run db:drop --workspace=price-parser-server",
		"db:migrate": "npm run db:migrate --workspace=price-parser-server",
		"db:studio": "npm run db:studio --workspace=price-parser-server",
		"test": "npm run test:run --workspace=price-parser-server"
	},
	"devDependencies": {
		"concurrently": "^9.1.2",
		"dprint": "^0.64.1"
	}
}
