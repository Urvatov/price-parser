		"bullmq": "^6.7.2",
		"dotenv": "^18.0.8",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"fastify": "^5.12.7",
		"ioredis": "^6.0.0",
		"playwright": "^1.64.1",
		"postgres": "^3.4.9"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"dprint": "^0.64.1",
		"tsup": "^9.0.0",
